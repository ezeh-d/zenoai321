ASSISTANT_NAME=REYES
USER_NAME=Boss
# Runtime separation: development | test | staging | production.
# Production refuses demo/mock backends at startup.
ZENO_ENV=development
ZENO_DEMO_MODE=false
# --- Brain: models are tried IN ORDER until one answers ---
# 1) LLM_MODEL is your primary. 2) LLM_FALLBACK_MODELS (optional, comma-separated)
# are tried next. 3) Any other provider below whose key is filled is added
# automatically. 4) Ollama (free/offline) is always the final fallback.
# Only fill the keys you actually have; the rest are skipped safely.

# Free & recommended: Gemini has a free key at aistudio.google.com
LLM_MODEL=gemini/gemini-1.5-flash
LLM_FALLBACK_MODELS=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Speech input --------------------------------------------------------
# Deepgram receives only VAD-bounded clips. WebView2 supplies its native
# noise suppression, echo cancellation and automatic gain control first.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en
# Nova-3 prompting helps preserve ZENO-specific names and wake phrases.
DEEPGRAM_KEYTERMS=Zeno,Divine
MIN_SPEECH_SECONDS=0.12
END_SILENCE_SECONDS=0.7
MAX_UTTERANCE_SECONDS=12
TRANSCRIBE_TIMEOUT_SECONDS=12
AGENT_QUEUE_CAPACITY=32
MIC_NOISE_CALIBRATION_SECONDS=0.75
MIC_VAD_OPEN_FACTOR=2.4
MIC_VAD_CLOSE_FACTOR=1.45

# --- Speech output -------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional original JARVIS specialist voice. If empty it safely uses ZENO's
# configured voice; it must not be a copied/impersonated film performance.
ELEVENLABS_VOICE_JARVIS=

# Free local fallback (install from ollama.com, then: ollama pull llama3)
OLLAMA_MODEL=ollama/llama3
OLLAMA_BASE_URL=http://localhost:11434
# Enable only after installing Ollama and pulling the configured model.
OLLAMA_ENABLED=false
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# OPENAI_BASE_URL=       # optional trusted OpenAI-compatible endpoint
# GEMINI_API_KEY=

# --- Remote access / mobile companion (all OFF by default) ---------------
# Enabling ZENO must never open a network surface, so every flag here is
# opt-in. With REMOTE_ACCESS_ENABLED unset, the /api/v1 endpoints refuse
# every request and the CORS allow-list is empty.
REMOTE_ACCESS_ENABLED=false
REMOTE_API_ENABLED=true
REMOTE_WEBSOCKET_ENABLED=true
REMOTE_PAIRING_ENABLED=true
REMOTE_PASSKEY_ENABLED=true
# Allows http://localhost origins. NEVER set this in production.
REMOTE_DEV_MODE=false

# The owner's real domain. Spelling is intentional.
# app./api. are derived from this unless set explicitly below.
ZENO_PUBLIC_DOMAIN=zenoassitant.com
ZENO_APP_ORIGIN=https://app.zenoassitant.com
ZENO_API_ORIGIN=https://api.zenoassitant.com

# ZENO Anywhere cloud gateway. The two SQLite paths MUST be on persistent
# encrypted-at-rest storage in a single-instance deployment. Do not commit
# real connector credentials; register the Windows device and put its values
# in the local Windows environment only.
ZENO_OWNER_AUTH_DB=
ZENO_DEVICE_LINK_DB=
ZENO_GATEWAY_URL=
ZENO_DEVICE_ID=
ZENO_DEVICE_TOKEN=
ZENO_DEVICE_LABEL=Main Windows laptop
# Netlify build-time public URL. This is intentionally public, never a token.
ZENO_PUBLIC_API_URL=https://api.zenoassitant.com

# Cloudflare Tunnel -- outbound only, no port forwarding, no open ports.
# Create the tunnel first; the config file path is whatever cloudflared wrote.
ZENO_PHONE_PUBLIC_HOST=api.zenoassitant.com
ZENO_CLOUDFLARE_TUNNEL_CONFIG=
ZENO_CLOUDFLARED_PATH=cloudflared
# Phone-as-mic uses the same passkey/device session and a narrow capability.
# Mobile getUserMedia requires the HTTPS host above. Phase 1 uses direct ICE
# on the local network; configure TURN separately before claiming internet use.
ZENO_REMOTE_MIC_ENABLED=true
ZENO_REMOTE_MIC_PROMOTE_SCORE=65
ZENO_REMOTE_MIC_DEMOTE_SCORE=35
# Private alternative to Cloudflare: join both devices to one tailnet, enable
# MagicDNS + HTTPS, then `tailscale serve --bg 8765`. Set the resulting FQDN:
# ZENO_PHONE_PUBLIC_HOST=desktop-name.tailnet-name.ts.net
# --- Phase 2 optional, lazy integrations ---------------------------------
# Living Memory remains active when Mem0 is off or unavailable.
ZENO_MEM0_ENABLED=false
ZENO_MEM0_MODE=local
ZENO_MEM0_USER_ID=divine
ZENO_MEM0_RETRIEVAL_TIMEOUT_S=1.5
# MEM0_API_KEY=          # only for ZENO_MEM0_MODE=platform

# One custom ONNX model may cover ZENO / Hey ZENO / Yo ZENO variants. The
# backend reuses WebView2's one microphone stream and never opens a second.
# ZENO_WAKE_MODEL_PATH=C:\path\to\zeno.onnx
ZENO_WAKE_SENSITIVITY=0.55
ZENO_WAKE_VAD_THRESHOLD=0.35
ZENO_WAKE_COOLDOWN_S=3
ZENO_WAKE_REQUIRED_HITS=2
ZENO_WAKE_NOISE_SUPPRESSION=true

# --- Human Companion V2 --------------------------------------------------
# Speaker verification is model-backed and local. The model is lazy-loaded;
# no raw enrolment recordings are retained. Voice identity still never
# authorizes payments, credential changes, or destructive/security actions.
ZENO_OWNER_VOICE_ENABLED=true
ZENO_3DSPEAKER_ENABLED=true
# ZENO_SPEAKER_MODEL_PATH=%LOCALAPPDATA%\ZENO\Models\speaker\3dspeaker_speech_campplus_sv_en_voxceleb_16k.onnx
ZENO_SPEAKER_HIGH_THRESHOLD=0.82
ZENO_SPEAKER_LIKELY_THRESHOLD=0.68
ZENO_SPEAKER_UNCERTAIN_THRESHOLD=0.52
ZENO_SPEAKER_MIN_QUALITY=0.48

# Acknowledgements are generated once in the configured ZENO ElevenLabs
# voice, cached, and then served cache-only on the realtime wake path.
ZENO_WAKE_ACK_PREWARM=true

# Time-to-audible-response target. Safe social replies bypass the provider;
# longer work gets a cache-only acknowledgement in ZENO's ElevenLabs voice.
ZENO_VOICE_RESPONSE_BUDGET_MS=1500
ZENO_THINKING_ACK_DELAY_MS=650
ZENO_FAST_LOCAL_REPLIES=true
ZENO_THINKING_ACK_ENABLED=true

# Heavy or unbenchmarked companion engines remain disabled by default.
ZENO_SPEECHBRAIN_ENABLED=false
ZENO_CLEARERVOICE_ENABLED=false
ZENO_TARGET_SPEAKER_ENABLED=false
ZENO_TEN_VAD_ENABLED=false
ZENO_TEN_TURN_ENABLED=false
ZENO_WINDOWS_AEC_ENABLED=true
ZENO_RNNOISE_ENABLED=false
ZENO_AASIST_ENABLED=false
ZENO_SIMULSTREAMING_ENABLED=false
ZENO_SENSEVOICE_ENABLED=false
ZENO_COSYVOICE_ENABLED=false
ZENO_PIPECAT_ENABLED=false
ZENO_TEN_FRAMEWORK_ENABLED=false
ZENO_SEAMLESS_ENABLED=false

# Open Interpreter is a lazy TOSIN specialist. It is never ZENO's brain and
# auto-run remains disabled; write work enters the existing confirmation gate.
ZENO_OPEN_INTERPRETER_ENABLED=false
ZENO_OPEN_INTERPRETER_COMMAND=interpreter
ZENO_OPEN_INTERPRETER_TIMEOUT_S=180
# Extra allowed roots are separated by ';' on Windows.
# ZENO_CODING_WORKSPACES=C:\Users\you\Desktop;C:\Users\you\Documents

# MCP servers are defined in the vault's 07-System/mcp/servers.json. A server
# must also be named here; ZENO never downloads or trusts one automatically.
ZENO_MCP_ALLOWLIST=

# --- Phase 3 advanced capabilities (heavy/external systems stay OFF) -----
# LiteLLM is already the installed provider abstraction. The switch keeps the
# enhanced gateway visible without creating an additional provider client.
ZENO_LITELLM_ENABLED=true
ZENO_EPISODIC_MEMORY_ENABLED=false
ZENO_SCREENPIPE_ENABLED=false
ZENO_SCREENPIPE_URL=http://127.0.0.1:3030
ZENO_EPISODIC_EXCLUSIONS=banking,password manager,incognito
ZENO_OPENADAPT_ENABLED=true
ZENO_GRAPHITI_ENABLED=false
ZENO_SHERPA_ENABLED=false
ZENO_DOCLING_ENABLED=false
ZENO_OPENHANDS_ENABLED=false
ZENO_AGENT_DEVICE_ENABLED=false
ZENO_PAIRED_DEVICE_IDS=
ZENO_SCRCPY_ENABLED=false
ZENO_KDE_CONNECT_ENABLED=false
ZENO_HOME_ASSISTANT_ENABLED=false
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
ZENO_LOCAL_LLM_ENABLED=false
ZENO_WHISPER_CPP_ENABLED=false
ZENO_WHISPER_CPP_COMMAND=whisper-cli
ZENO_SILERO_VAD_ENABLED=false
ZENO_E2B_ENABLED=false
E2B_API_KEY=
ZENO_LANGFUSE_ENABLED=false
ZENO_PHOENIX_ENABLED=false
ZENO_OBSERVABILITY_PROVIDER=local
ZENO_ACTIVITYWATCH_ENABLED=false
ZENO_ACTIVITYWATCH_URL=http://127.0.0.1:5600
# Reuses ZENO's one bounded scheduler; no second APScheduler process.
ZENO_SCHEDULER_ENABLED=true
ZENO_PROMPTFOO_TESTS_ENABLED=true
ZENO_PYWINAUTO_ENABLED=false
ZENO_OPA_ENABLED=false
ZENO_N8N_ENABLED=false
ZENO_N8N_WEBHOOK_URL=
ZENO_N8N_WEBHOOK_TOKEN=
ZENO_CROSS_DEVICE_ENABLED=false
ZENO_NOTIFICATION_PRIVACY=private
ZENO_DIGITAL_DNA_ENABLED=true

# Phase 5 optional services. Missing configuration is reported honestly;
# nothing below is started or downloaded on boot.
ZENO_STAGEHAND_URL=
STAGEHAND_TOKEN=
AGENT_VAULT_ADDR=
AGENT_VAULT_VAULT=
AGENT_VAULT_TOKEN=
ZENO_INFISICAL_ENABLED=false
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=
INFISICAL_TOKEN=
ZENO_AIO_SANDBOX_ENABLED=false
ZENO_AIO_SANDBOX_IMAGE=
ZENO_PRIVATE_NETWORK_MODE=TAILSCALE_MANAGED
ZENO_PRIVATE_PEER_ALLOWLIST=
ZENO_HEADSCALE_URL=
ZENO_PUSH_PROVIDER=
ZENO_NTFY_URL=
ZENO_NTFY_TOPIC=
NTFY_TOKEN=
ZENO_GOTIFY_URL=
GOTIFY_TOKEN=
ZENO_SENSEVOICE_MODEL=
ZENO_KOKORO_MODEL_READY=false
ZENO_KOKORO_LANGUAGE=b
ZENO_KOKORO_VOICE=bf_emma
ZENO_PIPER_MODEL=
ZENO_ANALYTICS_ROOTS=

# --- Magic MCP (21st.dev) -------------------------------------------------
# Component search and UI generation. NOTE: the server is a stdio proxy --
# every MCP message is forwarded to https://21st.dev/api/mcp, so prompts and
# generated code leave this machine. Two independent gates must both be set
# before it can run.
# 1. Your key from https://21st.dev/mcp
TWENTY_FIRST_API_KEY=
# 2. The server must be named in the MCP allowlist
ZENO_MCP_ALLOWLIST=21st-magic

# How long a voice conversation stays open without repeating the wake word.
# The wake word OPENS a conversation; it is not punctuation for every
# sentence. Bounded to 30s..3600s. Raise if you pause a lot mid-thought.
ZENO_CONVERSATION_IDLE_S=180
ZENO_VISIT_IDLE_S=300

# =========================================================================
# PREVIOUSLY UNDOCUMENTED -- added by the CI contract check
# =========================================================================
# `tools/check_env_documented.py` found 62 variables the code reads that this
# file never mentioned. An undocumented variable is one the owner cannot know
# to set; several below carry credentials. Documented here so the contract
# holds and CI can enforce it.

# --- Provider selection and limits ---------------------------------------
MODEL_PROVIDER=
ANTHROPIC_MODEL=
GEMINI_MODEL=
XAI_API_KEY=
XAI_MODEL=
MAX_OUTPUT_TOKENS=
AI_REQUEST_TIMEOUT_S=

# --- Credential-bearing. NEVER commit a real value to any of these. ------
# Gmail uses an APP PASSWORD, not the account password, and it belongs in the
# OS keyring rather than here. `reyes_agent/security/secrets/manager.py`
# reads the keyring first and falls back to the environment.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_ALLOWED_USER_IDS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_NOTIFY_CHAT_ID=
AUDD_API_TOKEN=
AUDD_TIMEOUT_S=
PHONE_PAIR_TOKEN=
ZENO_DESKTOP_MIC_TOKEN=

# --- Voice, wake and speech ----------------------------------------------
TTS_PROVIDER=
ELEVENLABS_MODEL=
WAKE_PHRASES=
WAKE_SENSITIVITY=
WAKE_CLAP_THRESHOLD=
PTT_KEY=
ZENO_STT_STREAMING=true
ZENO_FASTER_WHISPER_MODEL=
ZENO_FASTER_WHISPER_ALLOW_DOWNLOAD=false

# --- Autonomy and permissions --------------------------------------------
# These widen what ZENO may do without asking. Leave them off unless you have
# read what they unlock.
AUTONOMY_MODE=
AUTONOMY_ALLOW_DESTRUCTIVE=false
AUTONOMY_ALLOW_OUTBOUND=false
INSTALLATION_PROFILE=

# --- Browser --------------------------------------------------------------
BROWSER_HEADLESS=false
BROWSER_TIMEOUT_MS=

# --- Website builder ------------------------------------------------------
WEBSITE_BUILDER_ENABLED=
WEBSITE_WORKSPACE_PATH=
WEBSITE_AUTO_FIX=
WEBSITE_MAX_FIX_ATTEMPTS=
WEB_VERSIONING=
WEB_VISUAL_INSPECTION=

# --- Memory, workers and runtime -----------------------------------------
VAULT_PATH=
ZENO_ACTIVE_HISTORY=
ZENO_SESSION_MEMORY_LIMIT=
ZENO_WORKERS=
ZENO_WORK_QUEUE=
ZENO_TEST=
ZENO_PERFORMANCE_AUDIT=false
RESTORE_LAST_MODE=true
QUIET_HOURS_START=
QUIET_HOURS_END=

# --- Personality and mode presentation -----------------------------------
ZENO_HUMOUR_MODE=
ZENO_WISDOM_MODE=
ULTRON_INTRO_ANIMATION=true
ULTRON_VISUAL_QUALITY=

# --- Optional integrations (all default OFF) -----------------------------
ZENO_AGENT_FRAMEWORK_ENABLED=false
ZENO_BROWSER_AGENT_ENABLED=false
ZENO_CUA_ENABLED=false
ZENO_LIVEKIT_ENABLED=false
ZENO_OMNIPARSER_ENABLED=false
ZENO_PHONE_COMPANION_LOCAL_ENABLED=true
ZENO_TAILSCALE_SERVE_ENABLED=false
REMOTE_MIC_NETWORK_MODE=

# =========================================================================
# ZENO SOCIAL SYSTEM
# =========================================================================
# The whole subsystem is OFF until the owner turns it on, and even when on it
# starts in APPROVAL mode with dry run ENABLED. Nothing reaches a real
# platform until both switches are moved deliberately.

ZENO_SOCIAL_ENABLED=false

# The master safety switch. While true, every publish is simulated: content
# is created, scripted, captioned, scheduled and recorded, but no request
# reaches Instagram or TikTok. Turn this off only after reviewing a dry-run
# post end to end.
SOCIAL_DRY_RUN=true

# One flag that immediately stops scheduled publishing, automatic comments,
# automatic messages and every social background job. Already-published
# content is never deleted by it.
SOCIAL_AUTOMATION_KILL_SWITCH=false

# MANUAL | APPROVAL | TRUSTED_AUTONOMOUS. Starts at APPROVAL by design.
ZENO_SOCIAL_MODE=APPROVAL

# Only these content categories may publish without asking, and only when the
# mode is TRUSTED_AUTONOMOUS. Empty means nothing is trusted.
ZENO_SOCIAL_TRUSTED_CATEGORIES=

ZENO_SOCIAL_INSTAGRAM_ENABLED=false
ZENO_SOCIAL_TIKTOK_ENABLED=false

# Conservative starting cadence. ZENO may recommend changes from measured
# results; it may not raise these by itself.
ZENO_SOCIAL_IG_POSTS_PER_WEEK=3
ZENO_SOCIAL_TIKTOK_POSTS_PER_WEEK=3

# No publishing inside these hours (24h local).
ZENO_SOCIAL_QUIET_START=22
ZENO_SOCIAL_QUIET_END=7

# APPROVAL | TRUSTED | OFF -- how comment replies are handled.
ZENO_SOCIAL_COMMENT_MODE=APPROVAL
ZENO_SOCIAL_LEAD_DETECTION=true

# How often analytics are collected, in hours. Platform APIs are rate limited
# and analytics do not change minute to minute.
ZENO_SOCIAL_ANALYTICS_INTERVAL_H=24

# Concurrent social background jobs (rendering, analytics, research). Kept
# low so social work never competes with realtime conversation.
ZENO_SOCIAL_MAX_JOBS=2

# --- Instagram Graph API -------------------------------------------------
# Requires a Meta app, an Instagram Professional (Creator/Business) account,
# and a linked Facebook Page. See ZENO_INSTAGRAM_SETUP.md.
# Tokens belong in the OS keyring; the environment is the fallback.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_API_VERSION=v21.0

# --- TikTok Content Posting API ------------------------------------------
# Requires a TikTok for Developers app with video.publish scope approved.
# See ZENO_TIKTOK_SETUP.md.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_API_BASE=https://open.tiktokapis.com

# --- ZENO social identity ------------------------------------------------
# Presented as an AI assistant, never as a human being.
ZENO_SOCIAL_HANDLE=
ZENO_SOCIAL_DISPLAY_NAME=ZENO
ZENO_SOCIAL_WEBSITE=
ZENO_SOCIAL_CONTACT_EMAIL=

# --- Career / paid-work engine -------------------------------------------
# MANUAL: ZENO prepares applications, the owner submits them.
# APPROVAL (default): ZENO prepares and waits for an explicit owner decision.
# TRUSTED_AUTOMATION: only for categories the owner has named.
CAREER_APPLICATION_MODE=APPROVAL
# When true, the career engine prepares everything and submits nothing.
CAREER_ENGINE_DRY_RUN=false
