ASSISTANT_NAME=REYES
USER_NAME=Boss
# --- Brain: models are tried IN ORDER until one answers ---
# 1) LLM_MODEL is your primary. 2) LLM_FALLBACK_MODELS (optional, comma-separated)
# are tried next. 3) Any other provider below whose key is filled is added
# automatically. 4) Ollama (free/offline) is always the final fallback.
# Only fill the keys you actually have; the rest are skipped safely.

# Free & recommended: Gemini has a free key at aistudio.google.com
LLM_MODEL=gemini/gemini-1.5-flash
LLM_FALLBACK_MODELS=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Speech input --------------------------------------------------------
# Deepgram receives only VAD-bounded clips. WebView2 supplies its native
# noise suppression, echo cancellation and automatic gain control first.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en
# Nova-3 prompting helps preserve ZENO-specific names and wake phrases.
DEEPGRAM_KEYTERMS=Zeno,Divine
MIN_SPEECH_SECONDS=0.12
END_SILENCE_SECONDS=0.7
MAX_UTTERANCE_SECONDS=12
TRANSCRIBE_TIMEOUT_SECONDS=12
AGENT_QUEUE_CAPACITY=32
MIC_NOISE_CALIBRATION_SECONDS=0.75
MIC_VAD_OPEN_FACTOR=2.4
MIC_VAD_CLOSE_FACTOR=1.45

# --- Speech output -------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional original JARVIS specialist voice. If empty it safely uses ZENO's
# configured voice; it must not be a copied/impersonated film performance.
ELEVENLABS_VOICE_JARVIS=

# Free local fallback (install from ollama.com, then: ollama pull llama3)
OLLAMA_MODEL=ollama/llama3
OLLAMA_BASE_URL=http://localhost:11434
# Enable only after installing Ollama and pulling the configured model.
OLLAMA_ENABLED=false
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# --- Remote access / mobile companion (all OFF by default) ---------------
# Enabling ZENO must never open a network surface, so every flag here is
# opt-in. With REMOTE_ACCESS_ENABLED unset, the /api/v1 endpoints refuse
# every request and the CORS allow-list is empty.
REMOTE_ACCESS_ENABLED=false
REMOTE_API_ENABLED=true
REMOTE_WEBSOCKET_ENABLED=true
REMOTE_PAIRING_ENABLED=true
REMOTE_PASSKEY_ENABLED=true
# Allows http://localhost origins. NEVER set this in production.
REMOTE_DEV_MODE=false

# The owner's real domain. Spelling is intentional.
# app./api. are derived from this unless set explicitly below.
ZENO_PUBLIC_DOMAIN=zenoassitant.com
ZENO_APP_ORIGIN=https://app.zenoassitant.com
ZENO_API_ORIGIN=https://api.zenoassitant.com

# Cloudflare Tunnel -- outbound only, no port forwarding, no open ports.
# Create the tunnel first; the config file path is whatever cloudflared wrote.
ZENO_PHONE_PUBLIC_HOST=api.zenoassitant.com
ZENO_CLOUDFLARE_TUNNEL_CONFIG=
ZENO_CLOUDFLARED_PATH=cloudflared
# --- Phase 2 optional, lazy integrations ---------------------------------
# Living Memory remains active when Mem0 is off or unavailable.
ZENO_MEM0_ENABLED=false
ZENO_MEM0_MODE=local
ZENO_MEM0_USER_ID=divine
ZENO_MEM0_RETRIEVAL_TIMEOUT_S=1.5
# MEM0_API_KEY=          # only for ZENO_MEM0_MODE=platform

# One custom ONNX model may cover ZENO / Hey ZENO / Yo ZENO variants. The
# backend reuses WebView2's one microphone stream and never opens a second.
# ZENO_WAKE_MODEL_PATH=C:\path\to\zeno.onnx
ZENO_WAKE_SENSITIVITY=0.55
ZENO_WAKE_VAD_THRESHOLD=0.35
ZENO_WAKE_COOLDOWN_S=3
ZENO_WAKE_REQUIRED_HITS=2
ZENO_WAKE_NOISE_SUPPRESSION=true

# Open Interpreter is a lazy TOSIN specialist. It is never ZENO's brain and
# auto-run remains disabled; write work enters the existing confirmation gate.
ZENO_OPEN_INTERPRETER_ENABLED=false
ZENO_OPEN_INTERPRETER_COMMAND=interpreter
ZENO_OPEN_INTERPRETER_TIMEOUT_S=180
# Extra allowed roots are separated by ';' on Windows.
# ZENO_CODING_WORKSPACES=C:\Users\you\Desktop;C:\Users\you\Documents

# MCP servers are defined in the vault's 07-System/mcp/servers.json. A server
# must also be named here; ZENO never downloads or trusts one automatically.
ZENO_MCP_ALLOWLIST=
