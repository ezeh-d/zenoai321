# Secrets - never commit
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
credentials.json
secrets.json

# Python
__pycache__/
**pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# JavaScript
node_modules/
dist/
build/
.next/

# IDE and operating-system files
.vscode/
.idea/
.claude/
.DS_Store
Thumbs.db
desktop.ini

# Runtime files
/data/
/logs/
reyes_agent/state/
logs/
*.log
cache/
tmp/
temp/
runtime/
sessions/

# Generated voice and media
generated_audio/
audio_cache/
screenshots/
recordings/
captures/

# Browser profiles and Playwright data
playwright/.cache/
browser_profiles/
user_data/
chrome_profile/

# Local databases and indexes that should not be committed
*.sqlite-journal
*.db-journal
*.sqlite3-wal
*.sqlite3-shm
REYES/07-System/phase3_graph.sqlite3
*.sqlite

# Local model binaries
models/audio/*.onnx
models/audio/*.bin

# Legacy local conversation history
gui old/data/

# Crash and profiling files
*.dump
*.dmp
*.prof

# Personal vault and the runtime artefacts kept inside it.
REYES/
REYES (4)/

# Generated at build time by scripts/build-config.js (Netlify runs this).
web/zeno-config.js
web/_headers
web/app/

# TLS-interception CAs exported from the host's own trust store by
# tools/verify_docker.ps1. Machine-specific (this install's antivirus root),
# so it is regenerated rather than committed.
docker/certs/*.crt
!docker/certs/.gitkeep

# Third-party hacking-tool collections -- never commit into ZENO.
AllHackingTools-main/
hackingtool-master/

# Piper voice models (binary, ~60MB each) -- downloaded, not committed.
models/piper/*.onnx
models/piper/*.onnx.json
models/piper/*.wav

# Local Netlify folder
.netlify

# Self-extension runtime isolation and evidence. The redacted catalog and
# reviewed manifests remain versionable; environments/source quarantine do not.
extensions/environments/
extensions/quarantine/
extensions/history/
extensions/audit.jsonl

# Native Android Companion build/tooling output
**/.gradle/
**/local.properties
**/build/
*.apk
*.aab

# Vendored Pixi browser bundle (build artifact copied from node_modules)
reyes_agent/static/vendor/
